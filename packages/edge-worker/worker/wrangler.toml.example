# Copy to wrangler.toml for your own account. No real IDs are committed.
name = "galleryedge-demo"
main = "src/index.ts"
compatibility_date = "2026-01-01"

[vars]
DEMO_BANNER = "1"
# TURSO_URL = "libsql://<your-db>.turso.io"   (set via `wrangler secret put TURSO_URL`)
# TURSO_TOKEN                                 (set via `wrangler secret put TURSO_TOKEN`)
